-"""Legacy shim for MemEvol-lenient llm_fuzzy_match.
+"""Active shim for MemEvol-lenient llm_fuzzy_match.
 
-This module used to monkey-patch webarena's helper_functions.llm_fuzzy_match
-with a MemEvol-style lenient prompt. The vendored webarena tree at
-third_party/webarena/ now carries that prompt inline, so the monkey-patch is
-redundant; kept as a no-op only for import compatibility with run.py.
+Monkey-patches webarena's helper_functions.llm_fuzzy_match and evaluators.llm_fuzzy_match
+with the MemEvol containment-based prompt so that students providing additional correct context
+are not penalized with 'partially correct' (0.0).
 
 Usage:
     import webarena_patch  # noqa: F401
 """
+
+import os
+import logging
+from pathlib import Path
+from dotenv import load_dotenv
+
+_REPO_ROOT = Path(__file__).resolve().parents[2]
+if (_REPO_ROOT / ".env").exists():
+    load_dotenv(_REPO_ROOT / ".env")
+else:
+    load_dotenv()
+
+WA_DEFAULTS = {
+    "WA_SHOPPING_ADMIN": "http://localhost:7780/admin",
+    "WA_SHOPPING": "http://localhost:7780",
+    "WA_REDDIT": "http://localhost:9999",
+    "WA_GITLAB": "http://localhost:8023",
+    "WA_WIKIPEDIA": "http://localhost:8888",
+    "WA_MAP": "http://localhost:3000",
+    "WA_HOMEPAGE": "http://localhost:4399",
+}
+for k, v in WA_DEFAULTS.items():
+    if k not in os.environ:
+        os.environ[k] = v
+for _k in ("SHOPPING", "SHOPPING_ADMIN", "REDDIT", "GITLAB", "WIKIPEDIA", "MAP", "HOMEPAGE"):
+    if f"WA_{_k}" in os.environ and _k not in os.environ:
+        os.environ[_k] = os.environ[f"WA_{_k}"]
+
+logger = logging.getLogger(__name__)
+
+
+def _memevol_llm_fuzzy_match(pred: str, reference: str, question: str) -> float:
+    """Evaluate open-ended answers with containment-based instruction without penalizing extra info."""
+    if "OPENROUTER_API_KEY" in os.environ and "OPENAI_API_KEY" not in os.environ:
+        os.environ["OPENAI_API_KEY"] = os.environ["OPENROUTER_API_KEY"]
+    os.environ.setdefault("OPENAI_BASE_URL", "https://openrouter.ai/api/v1")
+
+    from webarena.llms.providers.openai_utils import generate_from_openai_chat_completion
+
+    message = (
+        "Help a teacher to grade the answer of a student given a question. The reference answer below is ONE part of the full expected answer. "
+        "Your job is to check whether the student's answer CONTAINS this specific piece of information, even if the student also provides additional correct information.\n"
+        "If the student's answer contains the reference information (possibly with different phrasing or wording), judge it as correct. "
+        "Do NOT penalize the student for including extra information beyond the reference.\n"
+        f"question: {question}\n"
+        f"reference answer (one part): {reference}\n"
+        "Important: The string 'N/A' means the task has no meaningful result. Both 'N/A' and equivalent answers like '0', '$0.00', 'none', or 'no results' should be treated as correct if the reference is 'N/A'.\n"
+        f"student answer: {pred}\n"
+        "Conclude the judgement by correct/incorrect/partially correct."
+    )
+    messages = [
+        {"role": "system", "content": "You are a helpful assistant"},
+        {"role": "user", "content": message},
+    ]
+
+    response = generate_from_openai_chat_completion(
+        model=os.environ.get("OPENAI_JUDGE_MODEL", "openai/gpt-4o-mini"),
+        messages=messages,
+        temperature=0,
+        max_tokens=768,
+        top_p=1.0,
+        context_length=0,
+    ).lower()
+
+    if "partially correct" in response or "incorrect" in response:
+        return 0.0
+    else:
+        assert "correct" in response
+        return 1.0
+
+
+# Apply monkey-patch to whatever webarena package is imported
+try:
+    import webarena.evaluation_harness.helper_functions as _hf
+    _hf.llm_fuzzy_match = _memevol_llm_fuzzy_match
+except Exception as e:
+    logger.debug("Failed to patch helper_functions.llm_fuzzy_match: %s", e)
+
+try:
+    import webarena.evaluation_harness.evaluators as _ev
+    _ev.llm_fuzzy_match = _memevol_llm_fuzzy_match
+except Exception as e:
+    logger.debug("Failed to patch evaluators.llm_fuzzy_match: %s", e)
+
+
+# Apply monkey-patch to MainPrompt._parse_answer for action loop guard & deduplication
+try:
+    from agents.legacy.dynamic_prompting import MainPrompt, ParseError
+
+    _orig_main_parse = MainPrompt._parse_answer
+
+    def _loop_guarded_main_parse(self, text_answer):
+        ans_dict = _orig_main_parse(self, text_answer)
+        raw_action = ans_dict.get("action", "")
+        if raw_action and isinstance(raw_action, str):
+            lines = [l.strip() for l in raw_action.strip().splitlines() if l.strip()]
+            deduped = []
+            has_send = False
+            for line in lines:
+                if has_send:
+                    break
+                if not deduped or line != deduped[-1]:
+                    deduped.append(line)
+                if "send_msg_to_user(" in line:
+                    has_send = True
+            cleaned_action = "\n".join(deduped)
+            ans_dict["action"] = cleaned_action
+
+            # Detect stagnation loops (same action repeated 2+ steps in history)
+            history_steps = getattr(self.history, "history_steps", []) or []
+            past_acts = [str(s.action).strip() for s in history_steps if hasattr(s, "action") and s.action]
+            if len(past_acts) >= 2 and past_acts[-1] and past_acts[-2]:
+                if cleaned_action == past_acts[-1] == past_acts[-2]:
+                    raise ParseError(
+                        f"Action loop detected: You have repeated the exact same action block '{cleaned_action}' for multiple steps without progress. "
+                        "Please check the current page carefully, try a different element/BID, scroll, or re-plan."
+                    )
+        return ans_dict
+
+    MainPrompt._parse_answer = _loop_guarded_main_parse
+    logger.info("Successfully patched MainPrompt._parse_answer with ActionLoopGuard")
+except Exception as e:
+    logger.debug("Failed to patch MainPrompt._parse_answer: %s", e)
