# Publish source, tests, research/configuration files, and documentation only.
# Raw runs, downloaded dependencies/data, and replay stores remain local.
/artifacts/
/.research-envs/
/data/
/outputs/
/runs/
/logs/
models/
datasets/
archives/
downloads/
bundles/
checkpoints/

# Credentials and machine-local configuration. Never commit real secrets.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.azure/
.gcloud/
.ssh/
secrets/
credentials/
credentials*.json
